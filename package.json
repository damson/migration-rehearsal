{
  "name": "migration-probe-pattern",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Damien D. <devddagnet@gmail.com>",
  "description": "Probe a pull request's migrations against real rows inside a rolled-back transaction: the article, two reference workflows and a tested reference implementation.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/damson/migration-probe-pattern.git"
  },
  "bugs": {
    "url": "https://github.com/damson/migration-probe-pattern/issues"
  },
  "homepage": "https://github.com/damson/migration-probe-pattern#readme",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "postgres",
    "migrations",
    "ci",
    "github-actions",
    "supabase",
    "database",
    "testing"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:placeholders": "node tools/check-placeholders.mjs",
    "probe": "tsx reference/run-probe.ts",
    "verify": "npm run typecheck && npm run test && npm run check:placeholders"
  },
  "dependencies": {
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "yaml": "^2.5.1"
  }
}
